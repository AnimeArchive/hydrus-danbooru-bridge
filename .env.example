# Copy to .env and fill in. Only HYDRUS_ACCESS_KEY is strictly required.

# --- Hydrus -----------------------------------------------------------------
# Hydrus client on the Docker host. Use https:// if you enabled https on the
# Client API (the self-signed cert is accepted unless HYDRUS_VERIFY_TLS=true).
HYDRUS_URL=http://host.docker.internal:45869
# services -> review services -> client api -> add -> manually.
# Needs: "search for and fetch files". For writes also: "edit file tags",
# "edit file ratings", "import and edit urls". Tag autocomplete needs "edit file tags" too.
HYDRUS_ACCESS_KEY=

# Tag service used for reading tags and searching (default: all known tags)
#HYDRUS_TAG_SERVICE_KEY=616c6c206b6e6f776e2074616773
# File domain searched (default: hydrus default = combined local file domains)
#HYDRUS_FILE_SERVICE_KEY=
# Tag service that Danbooru tag edits are written to (default: my tags)
#HYDRUS_WRITE_TAG_SERVICE_KEY=6c6f63616c2074616773
# Like/dislike rating service used as Danbooru favorites
#HYDRUS_FAVORITES_SERVICE=favourites
# Optional numerical or inc/dec rating service used as Danbooru score
#HYDRUS_SCORE_SERVICE=

# --- Bridge -----------------------------------------------------------------
# Strongly recommended if the port is reachable by anything but you.
# Clients then log in with login=BRIDGE_LOGIN and api_key=BRIDGE_API_KEY.
BRIDGE_LOGIN=hydrus
BRIDGE_API_KEY=
# Public URL clients use to reach the bridge (used in file_url etc).
# Leave empty to derive it from the Host / X-Forwarded-* headers.
#BRIDGE_PUBLIC_URL=https://booru.example.com
#ALLOW_WRITES=true
#DEFAULT_RATING=q
#SAMPLE_SIZE=850
#DEFAULT_LIMIT=20
#MAX_LIMIT=200
#SEARCH_CACHE_TTL=120
#FETCH_MD5=true
#BRIDGE_CORS=true
#LOG_LEVEL=INFO
#TZ=UTC

# JSON overrides, e.g. map hydrus "studio:" to copyright (3):
#NAMESPACE_MAP={"studio": 3}
#CATEGORY_NAMESPACE={"1": "creator"}
#RATING_NAMESPACE=rating
#RATING_TAG_MAP={"nsfw": "e", "sfw": "g"}
